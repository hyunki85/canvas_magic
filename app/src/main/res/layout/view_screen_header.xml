<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="4dp"
    android:background="@color/canvas_screen_background">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/screen_back" style="@style/CanvasTextAction"
        android:text="@string/drawing_pack_back" />
    <TextView android:id="@+id/screen_title"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:paddingVertical="8dp"
        android:textSize="20sp" android:textStyle="bold" android:maxLines="2"
        android:ellipsize="end" android:textColor="@color/canvas_tool_icon" />
</LinearLayout>
