<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/canvas_screen_background">
    <include layout="@layout/view_screen_header" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingBottom="12dp"
        android:text="@string/community_description" android:textSize="14sp"
        android:textColor="@color/text_secondary" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/tab_category"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:background="@color/canvas_screen_background"
        app:tabIndicatorColor="@color/primary" app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/text_secondary" app:tabTextAppearance="@style/ShareTabTextAppearance"
        app:tabIndicatorFullWidth="false" app:tabMode="fixed" app:tabGravity="fill">
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/featured" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/star" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/recent" />
    </com.google.android.material.tabs.TabLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_shape_online"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="88dp" />
        <TextView android:id="@+id/community_empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:padding="32dp" android:gravity="center" android:text="@string/community_empty"
            android:textSize="16sp" android:textColor="@color/text_secondary" android:visibility="gone" />
        <com.h2play.canvas_magic.features.common.ErrorView android:id="@+id/view_error"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_upload"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_margin="20dp"
            android:contentDescription="@string/upload_drawing_set"
            app:backgroundTint="@color/primary" app:tint="@color/white" app:srcCompat="@drawable/ic_upload_24" />
    </FrameLayout>
</LinearLayout>
