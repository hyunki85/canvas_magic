<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 캔버스 뷰 -->
    <com.h2play.canvas_magic.util.FabricView
        android:id="@+id/fabricView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 상단 클리어 버튼 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ib_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/clear"
        android:contentDescription="@string/error_reload"
        app:fabSize="mini"
        app:backgroundTint="@android:color/white"
        app:tint="@android:color/black"
        app:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 도구 모음 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toolbar_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <!-- 되돌리기 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ib_undo"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/undo"
                app:icon="@drawable/ic_undo"
                app:iconSize="24dp"
                app:iconTint="@android:color/black" />

            <!-- 색상 선택 버튼 (메인) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:src="@drawable/pallete"
                android:contentDescription="@string/select_color"
                app:fabSize="normal"
                app:tint="@android:color/white"
                app:elevation="4dp" />

            <!-- 지우개 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ib_erase"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/error_reload"
                app:icon="@drawable/eraser"
                app:iconSize="24dp"
                app:iconTint="@android:color/black" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 롱프레스 프로그레스 뷰 (튜토리얼용) -->
    <com.h2play.canvas_magic.util.LongPressProgressView
        android:id="@+id/long_press_progress"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:visibility="gone"
        android:elevation="16dp"
        app:layout_constraintBottom_toTopOf="@id/toolbar_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6" />

    <!-- 숨김 처리된 닫기 버튼 -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:padding="16dp"
        android:background="@drawable/bg_button"
        android:src="@drawable/close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>