<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/white" android:fitsSystemWindows="true">
    <!-- Keep full canvas bounds: saved reveal strokes use full-display coordinates. -->
    <com.h2play.canvas_magic.util.FabricView android:id="@+id/fabricView" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <View android:id="@+id/settings_shield" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/toolbar_card" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <FrameLayout android:id="@+id/inline_color_settings" android:layout_width="0dp" android:layout_height="350dp" android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/toolbar_card" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout android:id="@+id/toolbar_card" android:layout_width="0dp" android:layout_height="72dp" android:orientation="vertical" android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/canvas_toolbar_border"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/ib_undo" style="@style/CanvasToolbarIconButton" android:contentDescription="@string/undo" app:backgroundTint="@color/canvas_tool_button_background" app:icon="@drawable/ic_undo" app:iconGravity="textStart" app:iconTint="@color/canvas_tool_icon_tint" />
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <FrameLayout android:layout_width="52dp" android:layout_height="62dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_start" style="@style/CanvasToolbarIconButton" android:contentDescription="@string/select_color" app:backgroundTint="@color/canvas_tool_button_background" app:icon="@drawable/ic_palette_modern" app:iconGravity="textStart" app:iconTint="@color/canvas_tool_icon_tint" app:cornerRadius="26dp" android:layout_gravity="top|center_horizontal"/>
                <View android:id="@+id/current_color_indicator" android:layout_width="20dp" android:layout_height="3dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="3dp" android:importantForAccessibility="no"/>
            </FrameLayout>
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/ib_erase" style="@style/CanvasToolbarIconButton" android:contentDescription="@string/eraser" app:backgroundTint="@color/canvas_tool_button_background" app:icon="@drawable/ic_eraser_modern" app:iconGravity="textStart" app:iconTint="@color/canvas_tool_icon_tint" />
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/canvas_toolbar_border"/>
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/ib_clear" style="@style/CanvasToolbarIconButton" android:contentDescription="@string/clear_canvas" app:backgroundTint="@color/canvas_tool_button_background" app:icon="@drawable/ic_clear_canvas" app:iconGravity="textStart" app:iconTint="@color/canvas_tool_icon_tint" />
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:id="@+id/tutorial_coach" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:visibility="gone" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp"
        app:strokeColor="@color/canvas_toolbar_border" app:cardBackgroundColor="@color/canvas_toolbar_surface"
        app:layout_constraintWidth_max="560dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/coach_step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/primary_color"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/coach_skip" style="@style/CanvasTextAction" android:text="@string/tutorial_skip" android:textColor="@color/canvas_tool_icon"/>
            </LinearLayout>
            <TextView android:id="@+id/coach_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:lineSpacingExtra="3dp" android:textColor="@color/canvas_tool_icon" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.h2play.canvas_magic.util.LongPressProgressView android:id="@+id/long_press_progress" android:layout_width="80dp" android:layout_height="80dp" android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/toolbar_card" android:layout_marginBottom="24dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
